{
    "name": "opencart-to-shopify",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Migrates products, customers and order history from OpenCart 3.0 to Shopify through the Admin GraphQL API",
    "repository": {
        "type": "git",
        "url": "https://github.com/prdpmishra/opencart-to-shopify.git"
    },
    "engines": {
        "node": ">=22.13"
    },
    "main": "src/index.ts",
    "scripts": {
        "test": "tsx --test \"src/**/*.test.ts\"",
        "start": "tsx --env-file=.env src/index.ts",
        "migrate": "tsx --env-file=.env src/migrate.ts",
        "menu": "tsx --env-file=.env src/menu.ts",
        "customers": "tsx --env-file=.env src/customers.ts",
        "typecheck": "tsc --noEmit",
        "orders": "tsx --env-file=.env src/orders.ts",
        "related": "tsx --env-file=.env src/related.ts",
        "rollback": "tsx --env-file=.env src/rollback.ts"
    },
    "keywords": ["opencart", "shopify", "migration", "ecommerce"],
    "author": "Pradeep Mishra",
    "license": "ISC",
    "dependencies": {
        "he": "^2.0.0",
        "libphonenumber-js": "^1.13.16",
        "mysql2": "^3.24.6"
    },
    "devDependencies": {
        "@types/he": "^1.2.3",
        "@types/node": "^26.6.6",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
