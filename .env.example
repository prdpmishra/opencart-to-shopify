DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PREFIX=oc_
LANGUAGE_ID=1
OPENCART_IMAGE_DIR=
OPENCART_IMAGE_URL=
OPENCART_STORE_URL=
# PHP's time zone (date.timezone in php.ini), e.g. Europe/Berlin. OpenCart stores dates in it.
OPENCART_TIMEZONE=
# The shop's own order statuses, migrated like a default one: "own ID:default ID", e.g. 20:5,22:1
OPENCART_ORDER_STATUS_MAP=
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_LOCATION_ID=
# Only needed when Shopify "All prices include tax" is on, e.g. 20
PRICE_TAX_RATE=
